{
  "name": "@lanonasis/riskgpt",
  "version": "0.1.0",
  "private": true,
  "description": "RiskGPT bounded context for Vortex Security & Risk",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build --workspaces --if-present",
    "lint": "eslint src packages apps",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.10.0",
    "eslint": "^9.39.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
